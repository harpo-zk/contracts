{
  "name": "harpo-contracts",
  "version": "1.0.0",
  "description": "Smart contracts for Harpo ZK UTXO privacy system",
  "scripts": {
    "test": "npx hardhat test",
    "test:unit": "npx hardhat test test/unit/**/*.test.js",
    "test:integration": "npx hardhat test test/integration/**/*.test.js",
    "test:report": "npx hardhat test --timeout 60000 --reporter mochawesome --reporter-options reportDir=test/results,reportFilename=contract-test-report,html=true,json=true,overwrite=true",
    "test:watch": "npx hardhat test --watch",
    "compile": "npx hardhat compile",
    "clean": "npx hardhat clean && rm -rf test/results/*",
    "node": "npx hardhat node",
    "deploy": "npx hardhat run scripts/deploy.js",
    "coverage": "npx hardhat coverage"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@openzeppelin/contracts": "^5.2.0",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "chai": "^4.3.10",
    "ethers": "^6.4.0",
    "hardhat": "^2.22.5",
    "hardhat-gas-reporter": "^1.0.8",
    "mocha": "^10.2.0",
    "mochawesome": "^7.1.3",
    "solidity-coverage": "^0.8.1",
    "typechain": "^8.3.0"
  },
  "dependencies": {
    "circomlibjs": "^0.1.7",
    "dotenv": "^17.2.2",
    "ffjavascript": "^0.2.60",
    "snarkjs": "^0.7.5"
  },
  "keywords": [
    "smart-contracts",
    "zk-proofs",
    "privacy",
    "blockchain",
    "hardhat"
  ],
  "author": "Harpo Team",
  "license": "GPL-3.0"
}
